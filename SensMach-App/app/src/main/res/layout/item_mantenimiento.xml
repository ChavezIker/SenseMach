<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_aurea"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOrdEquipoTipo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SR-308 · Correctivo"
            android:textColor="@color/aurea_slate"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrdAlerta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_alerta"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="Próximo"
            android:textColor="@color/badge_alerta_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOrdActividades"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Actividades de mantenimiento"
        android:textColor="@color/aurea_text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvOrdRefacciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Refacciones: Kit SKF-20 · Fecha: 2026-11-20"
        android:textColor="@color/aurea_text_secondary"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConcluirOrden"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/badge_optimo_bg"
        android:text="✓ Concluir Orden"
        android:textColor="@color/badge_optimo_text"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />
</LinearLayout>
