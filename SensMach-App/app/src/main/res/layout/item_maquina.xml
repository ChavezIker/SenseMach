<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_aurea"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMaqNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TR-104 - Torno Industrial"
                android:textColor="@color/aurea_slate"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMaqModelo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CNC-TX200 · 1420 h"
                android:textColor="@color/aurea_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMaqEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_optimo"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Óptimo"
            android:textColor="@color/badge_optimo_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMaqTelemetria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Temp: 62.5°C  ·  Pres: 110.0 psi  ·  Vibr: 2.1 mm/s"
        android:textColor="@color/aurea_text_primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvMaqDiagnostico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Diagnóstico: Ninguna"
        android:textColor="@color/aurea_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
